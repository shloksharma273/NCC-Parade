HOST=0.0.0.0
PORT=8000
DIFFICULTY=2

# ── Network / Pairing ──────────────────────────────────────────────────────
# HOST_IP pins the IP address used in QR codes and pairing URLs.
# Leave blank to let the server auto-detect (works for most setups).
# Set this explicitly if auto-detection picks the wrong interface, e.g. on
# Ethernet-only PCs (no Wi-Fi), VPN machines, or multi-NIC servers.
# Example (Ethernet-only PC):
#   HOST_IP=192.168.1.100
HOST_IP=

# Camera mode: usb | ip
CAMERA_TYPE=usb

# USB camera (when CAMERA_TYPE=usb)
USB_CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# ── Multiple cameras ───────────────────────────────────────────────────────
# The camera chooser on the "New Drill Session" screen lists every USB and IP
# camera the server can reach, so CAMERA_TYPE below only decides the *default*
# pick — both kinds are usable regardless of it.
#
# You normally do NOT need to edit these by hand: the tablet has a
# "Configure Camera" screen (Admin -> Configure Camera) that tests credentials
# against the camera, detects its stream paths, and writes IP_CAMERAS below.
#
# Declare any number of IP cameras here, comma-separated, each as
#   slug|Label|rtsp_main|rtsp_sub          (rtsp_sub is optional)
# Example:
#   IP_CAMERAS=front|Front Gate|rtsp://admin:pw@192.168.1.50:554/main|rtsp://admin:pw@192.168.1.50:554/sub,side|Side Field|rtsp://admin:pw@192.168.1.51:554/main
# A bare RTSP URL on its own also works and gets an auto-generated label.
IP_CAMERAS=

# How many USB indices to probe when scanning for cameras (0..N-1).
USB_SCAN_MAX_INDEX=5
# How long a discovered camera list stays valid before a rescan (seconds).
DEVICE_DISCOVERY_TTL_SECONDS=30
# TCP knock timeout when checking whether an IP camera answers. Discovery never
# opens the RTSP stream itself — a dead stream blocks FFmpeg for 10-20 s.
RTSP_PREFLIGHT_TIMEOUT=1.0
# Optionally sweep the local /24 for port 554 and list anything found as
# "detected, not configured". Off by default: an open port reveals no stream
# path or credentials, so such a camera cannot actually be previewed.
IP_CAMERA_AUTOSCAN=false
IP_CAMERA_AUTOSCAN_TIMEOUT=2.5

# ── Chooser previews ───────────────────────────────────────────────────────
# Several cameras are held open at once for the chooser grid, so previews run at
# a deliberately low resolution — multiple USB cameras sharing one controller
# can run out of bandwidth at full size. Recording always uses CAMERA_WIDTH /
# CAMERA_HEIGHT and takes exclusive ownership of its camera.
PREVIEW_WIDTH=640
PREVIEW_HEIGHT=360
PREVIEW_FPS=15
PREVIEW_JPEG_QUALITY=70
# A camera nobody has asked about for this long is closed automatically, so an
# abandoned tablet does not hold every camera open indefinitely.
PREVIEW_IDLE_TIMEOUT_SECONDS=60

# IP camera (when CAMERA_TYPE=ip) — Secureye / generic RTSP
# These legacy single-camera settings still work and appear as one more entry
# in the camera list, alongside anything declared in IP_CAMERAS above.
IP_CAMERA_HOST=192.168.1.50
IP_CAMERA_PORT=554
IP_CAMERA_USERNAME=admin
IP_CAMERA_PASSWORD=your_password

# Full RTSP URLs (recommended — confirm paths from camera vendor / VLC test)
IP_CAMERA_RTSP_MAIN=rtsp://admin:your_password@192.168.1.50:554/main
IP_CAMERA_RTSP_SUB=rtsp://admin:your_password@192.168.1.50:554/sub

# Used only if RTSP URLs above are empty (paths vary by vendor)
IP_CAMERA_MAIN_PATH=main
IP_CAMERA_SUB_PATH=sub
IP_CAMERA_ACTIVE_STREAM=main

# Recording
RECORDING_BACKEND=opencv
RECORDING_FPS=20
RECORDING_WIDTH=2560
RECORDING_HEIGHT=1440
RECORDING_FORMAT=mp4

# Preview — sub stream is lower bandwidth for tablet
PREVIEW_USE_SUBSTREAM=true
PREVIEW_REFRESH_SECONDS=1
MAX_FRAME_READ_FAILURES=30
